{
    "id": "org.freedesktop.Sdk.Extension.haskell",
    "branch": "20.08",
    "runtime": "org.freedesktop.Sdk",
    "runtime-version": "20.08",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "separate-locales": false,
    "appstream-compose": false,
    "build-options": {
        "prepend-ld-library-path": "/usr/lib/sdk/haskell/lib/",
        "prefix": "/usr/lib/sdk/haskell"
    },
    "modules": [
        {
            "name": "ncurses",
            "no-autogen": true,
            "config-opts": [
                "--prefix=${FLATPAK_DEST}",
                "--with-shared",
                "--with-termlib=tinfo",
                "--with-versioned-syms"
            ],
            "make-install-args": [
                "install.libs"
            ],
            "cleanup": [
                "/bin",
                "/include",
                "/share/man",
                "/lib/*.a",
                "/lib/*.la"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ftp.gnu.org/gnu/ncurses/ncurses-6.3.tar.gz",
                    "sha256": "97fc51ac2b085d4cde31ef4d2c3122c21abc217e9090a43a30fc5ec21684e059",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 234776,
                        "stable-only": true,
                        "url-template": "https://ftp.gnu.org/gnu/ncurses/ncurses-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "libnuma",
            "buildsystem": "autotools",
            "make-args": [
                "install"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/numactl/numactl.git",
                    "tag": "v2.0.18",
                    "commit": "3871b1c42fc71bceadafd745d2eff5dddfc2d67e",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "ghc",
            "buildsystem": "autotools",
            "make-args": [
                "install"
            ],
            "sources": [
                {
                    "type": "archive",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://downloads.haskell.org/ghc/9.10.1/ghc-9.10.1-aarch64-deb10-linux.tar.xz",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://downloads.haskell.org/ghc/latest/",
                        "version-pattern": "ghc-([\\d.]+)[\\S]+\\.tar\\.xz",
                        "url-template": "https://downloads.haskell.org/ghc/$version/ghc-$version-aarch64-deb10-linux.tar.xz"
                    },
                    "sha256": "e6df50e62b696e3a8b759670fc79207ccc26e88a79a047561ca1ccb8846157dd"
                },
                {
                    "type": "archive",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://downloads.haskell.org/ghc/9.10.1/ghc-9.10.1-x86_64-deb10-linux.tar.xz",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://downloads.haskell.org/ghc/latest/",
                        "version-pattern": "ghc-([\\d.]+)[\\S]+\\.tar\\.xz",
                        "url-template": "https://downloads.haskell.org/ghc/$version/ghc-$version-x86_64-deb10-linux.tar.xz"
                    },
                    "sha256": "7fbdca8971c89a54cff8e88aee825c2ef2bcc9f7a050ee1e1e844763e39c361f"
                }
            ]
        },
        {
            "name": "cabal",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://downloads.haskell.org/cabal/cabal-install-3.12.1.0/cabal-install-3.12.1.0-aarch64-linux-deb10.tar.xz",
                    "strip-components": 0,
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://downloads.haskell.org/cabal/cabal-install-latest/",
                        "version-pattern": "cabal-install-([\\d.]+)[\\S]+\\.tar\\.xz",
                        "url-template": "https://downloads.haskell.org/cabal/cabal-install-$version/cabal-install-$version-aarch64-linux-deb10.tar.xz"
                    },
                    "sha256": "c01f2e0b3ba1fe4104cf2933ee18558a9b81d85831a145e8aba33fa172c7c618"
                },
                {
                    "type": "archive",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://downloads.haskell.org/cabal/cabal-install-3.12.1.0/cabal-install-3.12.1.0-x86_64-linux-deb10.tar.xz",
                    "strip-components": 0,
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://downloads.haskell.org/cabal/cabal-install-latest/",
                        "version-pattern": "cabal-install-([\\d.]+)[\\S]+\\.tar\\.xz",
                        "url-template": "https://downloads.haskell.org/cabal/cabal-install-$version/cabal-install-$version-x86_64-linux-deb10.tar.xz"
                    },
                    "sha256": "8c94fbd54bb0d50ee2a079e8332f74d94f78fabd45270ef9aec9d7878f0e65ee"
                }
            ],
            "build-commands": [
                "install -C ./cabal ${FLATPAK_DEST}/bin/"
            ]
        },
        {
            "name": "scripts",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "script",
                    "commands": [
                        "export PATH=$PATH:/usr/lib/sdk/haskell/bin",
                        "export LIBRARY_PATH=$LIBRARY_PATH:/usr/lib/sdk/haskell/lib"
                    ],
                    "dest-filename": "enable.sh"
                }
            ],
            "build-commands": [
                "cp enable.sh ${FLATPAK_DEST}"
            ]
        },
        {
            "name": "appdata",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p ${FLATPAK_DEST}/share/appdata",
                "cp org.freedesktop.Sdk.Extension.haskell.appdata.xml ${FLATPAK_DEST}/share/appdata",
                "appstream-compose --basename=org.freedesktop.Sdk.Extension.haskell --prefix=${FLATPAK_DEST} --origin=flatpak org.freedesktop.Sdk.Extension.haskell"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.haskell.appdata.xml"
                }
            ]
        }
    ]
}
